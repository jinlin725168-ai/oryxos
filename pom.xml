<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- OryxOS —— 企业级 Java 原生 Agent OS。Maven 多模块聚合父 POM。
       9 个模块见技术方案第 10 章。核心阶段是运行时内核骨架。 -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <groupId>com.oryxos</groupId>
  <artifactId>oryxos-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>OryxOS</name>
  <description>企业级 Java 原生 Agent OS —— 运行时内核</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <picocli.version>4.7.6</picocli.version>
    <sqlite.version>3.47.1.0</sqlite.version>
  </properties>

  <modules>
    <module>oryxos-core</module>
    <module>oryxos-provider</module>
    <module>oryxos-memory</module>
    <module>oryxos-tool</module>
    <module>oryxos-channel-cli</module>
    <module>oryxos-web</module>
    <module>oryxos-storage</module>
    <module>oryxos-cli</module>
    <module>oryxos-boot</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- 内部模块统一版本 -->
      <dependency><groupId>com.oryxos</groupId><artifactId>oryxos-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.oryxos</groupId><artifactId>oryxos-provider</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.oryxos</groupId><artifactId>oryxos-memory</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.oryxos</groupId><artifactId>oryxos-tool</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.oryxos</groupId><artifactId>oryxos-channel-cli</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.oryxos</groupId><artifactId>oryxos-web</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.oryxos</groupId><artifactId>oryxos-storage</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.oryxos</groupId><artifactId>oryxos-cli</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.oryxos</groupId><artifactId>oryxos-boot</artifactId><version>${project.version}</version></dependency>

      <!-- 第三方（Spring Boot BOM 未管理的） -->
      <dependency><groupId>info.picocli</groupId><artifactId>picocli</artifactId><version>${picocli.version}</version></dependency>
      <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>${sqlite.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.oryxos</groupId>
    <artifactId>oryxos-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>oryxos-cli</artifactId>
  <name>oryxos-cli</name>
  <description>命令行入口：Picocli 主入口、12 个子命令、ConfigLoader</description>

  <dependencies>
    <dependency>
      <groupId>com.oryxos</groupId>
      <artifactId>oryxos-core</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>oryxos-cli</finalName>
    <plugins>
      <!-- 额外产出一个可执行 jar：oryxos-cli-exec.jar（classifier=exec）。
           主构件仍是普通 jar，供 oryxos-boot 作为依赖引用；exec 分类件用于 `java -jar` 直接运行。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.oryxos.cli.OryxOsCli</mainClass>
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
